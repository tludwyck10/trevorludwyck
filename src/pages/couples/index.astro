---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { couples } from '../../data/gallery.js';
---

<BaseLayout
  title="Couples Portraits — Dallas–Fort Worth, TX Editorial Photographer"
  description="Editorial couples portraiture for engagements and established couples in Dallas–Fort Worth, TX. A standalone session about the relationship — not a wedding add-on."
>
  <section class="page-intro wrap">
    <p class="eyebrow">Couples Portraits</p>
    <h1>A session about the two of you.</h1>
    <p class="page-intro__copy">
      This isn't a wedding vendor add-on. Whether you're newly engaged or
      years into it, a couples session stands on its own — built the same
      deliberate, light-first way as everything else. For engagements and
      established couples alike.
    </p>
    <a href="/investment/" class="btn">See Investment</a>
  </section>

  <section class="page-gallery wrap">
    <Gallery images={couples} />
  </section>

  <section class="page-cta wrap">
    <h2>Ready to plan a session?</h2>
    <a href="/contact/" class="btn btn--gold">Inquire</a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-lg);
    max-width: 680px;
  }

  .page-intro h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .page-intro__copy {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 55ch;
  }

  .page-gallery {
    padding-bottom: var(--space-xl);
  }

  .page-cta {
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .page-cta h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: var(--space-md);
  }
</style>
