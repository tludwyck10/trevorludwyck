---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';

// TODO: replace with your real Formspree endpoint.
// Sign up free at https://formspree.io, create a form, and swap the ID
// below (the part after /f/) — submissions will then email you directly.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';
---

<BaseLayout
  title="Contact"
  description="Inquire about a portrait session or event coverage with Trevor Ludwyck Photography, serving Celina, TX and Dallas–Fort Worth."
>
  <section class="estimate wrap" id="estimate">
    <p class="eyebrow">Get an Estimate</p>
    <h1>Not sure what to expect?</h1>
    <p class="estimate__copy">
      Pick a category and tier for a quick price range, then carry it
      straight into your inquiry below.
    </p>
    <PricingCalculator />
  </section>

  <section class="contact wrap">
    <div class="contact__intro">
      <p class="eyebrow">Contact</p>
      <h2>Let's talk about your session.</h2>
      <p>
        Tell me a bit about what you're looking for and I'll follow up by
        email to find a time that works.
      </p>
    </div>

    <form class="contact__form" id="contact-form" action={FORMSPREE_ENDPOINT} method="POST">
      <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="estimate" id="estimate-field" />

      <div class="contact__estimate-chip" id="estimate-chip" hidden>
        <p>
          Estimate: <strong id="estimate-chip-text"></strong>
        </p>
        <button type="button" id="estimate-chip-clear">Change</button>
      </div>

      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="session-type">Session type</label>
        <select id="session-type" name="session_type" required>
          <option value="" disabled selected>Select one</option>
          <option value="Portraits">Portraits</option>
          <option value="Moments / Event">Moments / Event</option>
        </select>
      </div>

      <div class="field">
        <label for="date-flexibility">Date flexibility</label>
        <input
          type="text"
          id="date-flexibility"
          name="date_flexibility"
          placeholder="e.g. flexible within October, or a specific date"
        />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn btn--gold">Send Inquiry</button>
    </form>
  </section>
</BaseLayout>

<style>
  .estimate {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-lg);
    max-width: 760px;
  }

  .estimate h1 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .estimate__copy {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-bottom: var(--space-md);
  }

  .contact {
    padding-block: var(--space-lg) var(--space-xl);
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .contact__intro h2 {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .contact__intro p {
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 560px;
  }

  .contact__estimate-chip[hidden] {
    display: none;
  }

  .contact__estimate-chip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
  }

  .contact__estimate-chip strong {
    color: var(--color-text);
  }

  .contact__estimate-chip button {
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text);
    border-radius: 0;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .contact__form .btn {
    align-self: flex-start;
    border: none;
    cursor: pointer;
    background: var(--color-gold);
    color: var(--color-black);
  }

  .contact__form .btn:hover {
    background: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const chip = document.getElementById('estimate-chip') as HTMLElement;
  const chipText = document.getElementById('estimate-chip-text') as HTMLElement;
  const chipClear = document.getElementById('estimate-chip-clear') as HTMLButtonElement;
  const estimateField = document.getElementById('estimate-field') as HTMLInputElement;
  const sessionType = document.getElementById('session-type') as HTMLSelectElement;

  document.addEventListener('estimate:selected', (event) => {
    const detail = (event as CustomEvent).detail;
    const summary = `${detail.categoryLabel} — ${detail.tier} (${detail.priceText}${detail.note ? `, ${detail.note}` : ''})`;

    chipText.textContent = summary;
    chip.hidden = false;
    estimateField.value = summary;

    if (detail.category === 'portraits') {
      sessionType.value = 'Portraits';
    } else if (detail.category === 'moments') {
      sessionType.value = 'Moments / Event';
    }
  });

  chipClear?.addEventListener('click', () => {
    chip.hidden = true;
    estimateField.value = '';
    sessionType.value = '';
    document.getElementById('estimate')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
