---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { about } from '../../data/gallery.js';
---

<BaseLayout
  title="About"
  description="Trevor Ludwyck is a portrait photographer based in Celina, TX, working throughout Dallas–Fort Worth. Every session is built around deliberate lighting."
>
  <section class="about wrap">
    <div class="about__image">
      <ResponsiveImage src={about.src} alt={about.alt} sizes="(min-width: 900px) 40vw, 100vw" />
    </div>
    <div class="about__content">
      <p class="eyebrow">About</p>
      <h1>Lighting first, always.</h1>
      <p>
        My approach starts before a single frame is shot: where is the light,
        where will it be in an hour, and what does it do to a face. That
        planning is the actual craft — everything else is secondary.
      </p>
      <p>
        My work is portraits — not weddings, not events, not families. That
        narrow focus means every session gets the same level of attention
        to light and composition, shot after shot.
      </p>
      <p>
        Simple, deliberate, and built to hold up over time rather than
        chase a trend. Based in Celina, TX, working throughout
        Dallas–Fort Worth.
      </p>
      <a href="/contact/" class="btn">Inquire</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-xl);
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .about__image :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__content h1 {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .about__content p {
    margin-bottom: var(--space-sm);
    max-width: 58ch;
    color: var(--color-text-muted);
  }

  .about__content .btn {
    margin-top: var(--space-sm);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
