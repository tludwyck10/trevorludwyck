---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { about } from '../../data/gallery.js';
---

<BaseLayout
  title="About"
  description="Trevor Ludwyck is a photographer based in Celina, TX, working throughout Dallas–Fort Worth. Oklahoma-raised, Oklahoma State journalism grad, and full-time staff at Shoreline City Church."
>
  <section class="about wrap">
    <div class="about__image">
      <ResponsiveImage src={about.src} alt={about.alt} sizes="(min-width: 900px) 40vw, 100vw" />
    </div>
    <div class="about__content">
      <p class="eyebrow">About</p>
      <h1>Less is more.</h1>
      <p>
        I was born and raised in Oklahoma, where I fell in love with
        photography young — photographing wildlife and hunting alongside my
        dad.
      </p>
      <p>
        I studied journalism at Oklahoma State University, where I met my
        wife. We live in Celina, TX, where I'm on staff full-time at our
        church, Shoreline City.
      </p>
      <p>
        Photography is a way of freezing a moment in time — and using it to
        tell the story of who someone is and what they love. My style is
        simple: less is more, and real skill shows up as efficiency.
      </p>
      <a href="/contact/" class="btn">Inquire</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-xl);
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .about__image :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about__content h1 {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .about__content p {
    margin-bottom: var(--space-sm);
    max-width: 58ch;
    color: var(--color-text-muted);
  }

  .about__content .btn {
    margin-top: var(--space-sm);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
