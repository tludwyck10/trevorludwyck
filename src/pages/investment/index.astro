---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingCard from '../../components/PricingCard.astro';
import { pricing } from '../../data/pricing.js';
---

<BaseLayout
  title="Investment"
  description="Pricing for portrait sessions and event coverage from Trevor Ludwyck Photography, serving Celina, TX and Dallas–Fort Worth."
>
  <section class="page-intro wrap">
    <p class="eyebrow">Investment</p>
    <h1>Simple pricing, two ways to book.</h1>
    <p class="page-intro__copy">
      No à la carte maze — each session type, portrait or event, has two
      clear tiers. Every package includes an online gallery and
      downloadable digital images. Not sure which one fits? Use the
      <a href="/contact/#estimate">estimate calculator</a> on the Contact page.
    </p>
  </section>

  {Object.values(pricing).map((group) => (
    <section class="pricing-group wrap">
      <h2 class="pricing-group__title">{group.label}</h2>
      <div class="pricing-grid">
        {group.tiers.map((tier) => (
          <PricingCard tier={tier.name} price={tier.price} featured={tier.featured} features={tier.features} />
        ))}
      </div>
      {group.travelFee && <p class="pricing-note">Travel beyond the included radius: +${group.travelFee}.</p>}
    </section>
  ))}

  <section class="page-cta wrap">
    <h2>Have questions about a session?</h2>
    <a href="/contact/" class="btn btn--gold">Inquire</a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-lg);
    max-width: 680px;
  }

  .page-intro h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .page-intro__copy {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .page-intro__copy a {
    color: var(--color-text);
    text-decoration-color: var(--color-gold);
  }

  .pricing-group {
    padding-bottom: var(--space-lg);
  }

  .pricing-group__title {
    font-size: 1.4rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .pricing-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
  }

  .page-cta {
    padding-block: var(--space-md) var(--space-xl);
    text-align: center;
  }

  .page-cta h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: var(--space-md);
  }

  @media (max-width: 720px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
