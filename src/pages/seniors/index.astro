---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { seniors } from '../../data/gallery.js';
---

<BaseLayout
  title="Senior Portraits — Celina & Dallas–Fort Worth, TX"
  description="Editorial senior portraits in Celina, TX and the Dallas–Fort Worth area. Timeless, not trendy — built on deliberate lighting, not props or trends."
>
  <section class="page-intro wrap">
    <p class="eyebrow">Senior Portraits</p>
    <h1>Timeless, not trendy.</h1>
    <p class="page-intro__copy">
      Senior portraits shouldn't chase a look that fades with the year. Each
      session is built around light and your senior — not a trend board.
      The result is a set of images that will read the same in twenty years
      as they do today.
    </p>
    <a href="/investment/" class="btn">See Investment</a>
  </section>

  <section class="page-gallery wrap">
    <Gallery images={seniors} />
  </section>

  <section class="page-cta wrap">
    <h2>Ready to plan a session?</h2>
    <a href="/contact/" class="btn btn--gold">Inquire</a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-lg);
    max-width: 680px;
  }

  .page-intro h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .page-intro__copy {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    max-width: 55ch;
  }

  .page-gallery {
    padding-bottom: var(--space-xl);
  }

  .page-cta {
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .page-cta h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: var(--space-md);
  }
</style>
