---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import { home } from '../data/gallery.js';
---

<BaseLayout
  title="Photography in Celina & Dallas–Fort Worth, TX"
  description="Trevor Ludwyck Photography — portrait sessions and event coverage in Celina, TX, serving Dallas–Fort Worth. Built on deliberate lighting, not high-volume shooting."
>
  <section class="home-gallery wrap">
    <Gallery images={home} />
  </section>
</BaseLayout>

<style>
  .home-gallery {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }
</style>
