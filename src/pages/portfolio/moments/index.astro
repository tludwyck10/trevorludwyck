---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Gallery from '../../../components/Gallery.astro';
import { moments } from '../../../data/gallery.js';
---

<BaseLayout
  title="Moments — Celina & Dallas–Fort Worth, TX"
  description="Event and candid photography — receptions, celebrations, and moments worth keeping — in Celina, TX and the Dallas–Fort Worth area."
>
  <section class="page-intro wrap">
    <p class="eyebrow">Moments</p>
    <h1>The moments in between.</h1>
    <p class="page-intro__copy">
      Toasts, glances, the room when no one's posing — covered the same
      deliberate way as everything else. Built around light, not a shot
      list.
    </p>
  </section>

  <section class="page-gallery wrap">
    <Gallery images={moments} hoverColor />
  </section>

  <section class="page-cta wrap">
    <h2>Have an event coming up?</h2>
    <a href="/contact/" class="btn btn--gold">Inquire</a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: calc(var(--space-xl) + 2rem) var(--space-lg);
    max-width: 680px;
  }

  .page-intro h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-block: var(--space-sm) var(--space-md);
  }

  .page-intro__copy {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .page-gallery {
    padding-bottom: var(--space-xl);
  }

  .page-cta {
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .page-cta h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: var(--space-md);
  }
</style>
