---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { portfolioCover } from '../../data/gallery.js';
---

<BaseLayout
  title="Portfolio"
  description="Trevor Ludwyck Photography portfolio — portrait sessions in Celina, TX and the Dallas–Fort Worth area."
  navVariant="overlay"
>
  <a href="/portfolio/gallery/" class="cover" aria-label="View the portfolio gallery">
    <ResponsiveImage src={portfolioCover.src} alt={portfolioCover.alt} sizes="100vw" priority class="cover__image" />
    <div class="cover__scrim" aria-hidden="true"></div>
    <div class="cover__content wrap">
      <p class="cover__eyebrow">Portrait Photography</p>
      <h1 class="cover__title">Portfolio</h1>
      <div class="cover__foot">
        <p class="cover__line">Portraits, considered.</p>
        <span class="cover__cta">View the Gallery <span aria-hidden="true">&rarr;</span></span>
      </div>
    </div>
  </a>
</BaseLayout>

<style>
  .cover {
    position: relative;
    display: block;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--color-black);
    text-decoration: none;
    color: var(--color-white);
  }

  .cover :global(.cover__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .cover:hover :global(.cover__image) {
    transform: scale(1.02);
  }

  .cover__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 18, 15, 0.15) 0%, rgba(20, 18, 15, 0.05) 35%, rgba(20, 18, 15, 0.65) 100%);
  }

  .cover__content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: var(--space-xl);
  }

  .cover__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  .cover__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(3.5rem, 13vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }

  .cover__foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    padding-top: var(--space-sm);
  }

  .cover__line {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .cover__cta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
