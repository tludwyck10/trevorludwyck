---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCover from '../../components/CategoryCover.astro';
import { portraitsCover, momentsCover } from '../../data/gallery.js';
---

<BaseLayout
  title="Portfolio"
  description="Trevor Ludwyck Photography portfolio — portrait sessions and event coverage in Celina, TX and the Dallas–Fort Worth area."
>
  <h1 class="visually-hidden">Portfolio</h1>

  <CategoryCover
    title="Portraits"
    label="Portrait Photography"
    line="Portraits, considered."
    copy="Every session starts with the light, not a prop list or a trend. What follows is a small, considered set of images."
    href="/portfolio/portraits/"
    imageSrc={portraitsCover.src}
    imageAlt={portraitsCover.alt}
    priority
  />

  <CategoryCover
    title="Moments"
    label="Event Photography"
    line="Moments, kept."
    copy="Coverage for the parts of an event that actually matter — the toasts, the reactions, the room. Built around light, not a checklist."
    href="/portfolio/moments/"
    imageSrc={momentsCover.src}
    imageAlt={momentsCover.alt}
  />
</BaseLayout>
