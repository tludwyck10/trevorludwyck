---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__wrap">
    <a href="/" class="site-footer__mark">
      <span class="site-footer__mark-name">Trevor Ludwyck</span>
      <span class="site-footer__mark-rule" aria-hidden="true"></span>
      <span class="site-footer__mark-role">Photography</span>
    </a>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/portfolio/">Portfolio</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>

    <div class="site-footer__meta">
      <p>Celina, TX</p>
      <p>&copy; {year} Trevor Ludwyck Photography</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-black);
    color: var(--color-cream);
    padding-block: var(--space-lg) var(--space-md);
  }

  .site-footer__wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .site-footer__mark {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-white);
  }

  .site-footer__mark-name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .site-footer__mark-rule {
    width: 1px;
    height: 16px;
    background: var(--color-gold);
  }

  .site-footer__mark-role {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .site-footer__nav a {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream);
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .site-footer__nav a:hover {
    opacity: 1;
    color: var(--color-gold);
  }

  .site-footer__meta {
    font-size: 0.8rem;
    opacity: 0.65;
    text-align: right;
  }

  .site-footer__meta p {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 720px) {
    .site-footer__wrap {
      flex-direction: column;
      gap: var(--space-md);
    }

    .site-footer__meta {
      text-align: left;
    }
  }
</style>
