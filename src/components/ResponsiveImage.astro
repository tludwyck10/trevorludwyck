---
// Real local photos (imported from src/assets/images/...) are optimized
// and resized at build time via Astro's <Image>. Remaining placeholder
// images (picsum.photos / Unsplash URLs, used where real photos don't
// exist yet — e.g. senior portraits) keep the manual srcset below, since
// Astro can't optimize remote URLs it doesn't control.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, priority = false, class: className } = Astro.props;

const widths = [480, 768, 1024, 1440, 1920, 2400];

function buildSrcSet(url: string) {
  const picsum = url.match(/^https:\/\/picsum\.photos\/seed\/([^/]+)\/(\d+)\/(\d+)(\?.*)?$/);
  if (picsum) {
    const [, seed, w, h, query] = picsum;
    const ratio = Number(h) / Number(w);
    return widths
      .map((width) => `https://picsum.photos/seed/${seed}/${width}/${Math.round(width * ratio)}${query ?? ''} ${width}w`)
      .join(', ');
  }

  if (url.startsWith('https://images.unsplash.com/')) {
    return widths
      .map((width) => {
        const variant = new URL(url);
        variant.searchParams.set('w', String(width));
        return `${variant.toString()} ${width}w`;
      })
      .join(', ');
  }

  return undefined;
}
---

{typeof src === 'string' ? (
  <img
    src={src}
    srcset={buildSrcSet(src)}
    sizes={sizes}
    alt={alt}
    class={className}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />
) : (
  <Image
    src={src}
    alt={alt}
    sizes={sizes}
    widths={widths.filter((w) => w <= src.width).length ? widths.filter((w) => w <= src.width) : [src.width]}
    format="webp"
    quality={82}
    class={className}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
  />
)}
