---
import ResponsiveImage from './ResponsiveImage.astro';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  src: string | ImageMetadata;
  alt: string;
  href?: string;
}

interface Props {
  images: GalleryItem[];
}

const { images } = Astro.props;
---

<div class="gallery">
  {images.map((image) => (
    <figure class="gallery__item">
      {image.href ? (
        <a href={image.href} class="gallery__link">
          <ResponsiveImage src={image.src} alt={image.alt} sizes="(min-width: 1100px) 33vw, (min-width: 720px) 50vw, 100vw" />
        </a>
      ) : (
        <ResponsiveImage src={image.src} alt={image.alt} sizes="(min-width: 1100px) 33vw, (min-width: 720px) 50vw, 100vw" />
      )}
    </figure>
  ))}
</div>

<style>
  .gallery {
    column-count: 3;
    column-gap: var(--gutter);
  }

  .gallery__item {
    margin: 0 0 var(--gutter);
    break-inside: avoid;
  }

  .gallery__item :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.2s ease;
  }

  .gallery__link:hover :global(img) {
    opacity: 0.85;
  }

  @media (max-width: 1000px) {
    .gallery {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .gallery {
      column-count: 1;
    }
  }
</style>
