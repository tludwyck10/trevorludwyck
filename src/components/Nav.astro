---
interface Props {
  // 'overlay' = transparent bar with white text over a dark hero image.
  // 'solid' = white bar with dark text, for pages with no full-bleed hero.
  variant?: 'overlay' | 'solid';
}
const { variant = 'overlay' } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/investment/', label: 'Investment' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  return path === href;
}
---

<header class:list={['site-nav', variant === 'solid' && 'site-nav--solid']}>
  <div class="site-nav__wrap wrap">
    <a href="/" class="site-nav__mark">Trevor Ludwyck <span>Photography</span></a>

    <button class="site-nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
    </button>

    <nav class="site-nav__menu" id="nav-menu">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 40;
    padding-block: var(--space-sm);
    color: var(--color-white);
  }

  .site-nav--solid,
  .site-nav.is-scrolled {
    position: sticky;
    background: var(--color-white);
    color: var(--color-black);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav__wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .site-nav__mark {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .site-nav__mark span {
    font-weight: 400;
    opacity: 0.85;
  }

  .site-nav__menu ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__menu a {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    opacity: 0.85;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .site-nav__menu a:hover,
  .site-nav__menu a[aria-current='page'] {
    opacity: 1;
    border-color: var(--color-gold);
  }

  .site-nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .site-nav__toggle-bar {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 720px) {
    .site-nav__toggle {
      display: flex;
    }

    .site-nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-white);
      color: var(--color-black);
      border-bottom: 1px solid var(--color-border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .site-nav__menu.is-open {
      max-height: 320px;
    }

    .site-nav__menu ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-sm) var(--gutter) var(--space-md);
    }

    .site-nav__menu li {
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__menu a {
      display: block;
      padding-block: 0.9rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const nav = document.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 40) {
      nav.classList.add('is-scrolled');
    } else {
      nav.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
